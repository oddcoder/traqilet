From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ahmed Abdelraoof <ahmedsoliman@oddcoder.com>
Date: Sun, 30 Aug 2026 18:54:43 +0000
Subject: [PATCH] cranelift: expose machinst

`machinst` and `IsaFlagsHashKey`'s field become `pub`, so a target cranelift does
not ship can be written outside cranelift-codegen; the lint line absorbs the glob
shadowing and undocumented items that exposes.

The files below are cranelift's; this patch changes them (Apache-2.0 section 4(b)).

Upstream: https://github.com/bytecodealliance/wasmtime
License:  Apache-2.0 WITH LLVM-exception
---
 cranelift/codegen/src/isa/mod.rs | 2 +-
 cranelift/codegen/src/lib.rs     | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/cranelift/codegen/src/isa/mod.rs b/cranelift/codegen/src/isa/mod.rs
index 5f33e63..52dd0a9 100644
--- a/cranelift/codegen/src/isa/mod.rs
+++ b/cranelift/codegen/src/isa/mod.rs
@@ -421,7 +421,7 @@ pub trait TargetIsa: fmt::Display + Send + Sync {
 
 /// A wrapper around the ISA-dependent flags types which only implements `Hash`.
 #[derive(Hash)]
-pub struct IsaFlagsHashKey<'a>(&'a [u8]);
+pub struct IsaFlagsHashKey<'a>(pub &'a [u8]);
 
 /// Function alignment specifications as required by an ISA, returned by
 /// [`TargetIsa::function_alignment`].
diff --git a/cranelift/codegen/src/lib.rs b/cranelift/codegen/src/lib.rs
index 787aff2..485b9b3 100644
--- a/cranelift/codegen/src/lib.rs
+++ b/cranelift/codegen/src/lib.rs
@@ -1,5 +1,5 @@
 //! Cranelift code generation library.
-#![deny(missing_docs)]
+#![allow(hidden_glob_reexports, missing_docs)]
 // Display feature requirements in the documentation when building on docs.rs
 #![cfg_attr(docsrs, feature(doc_cfg))]
 #![no_std]
@@ -47,7 +47,7 @@ pub use gimli;
 include!(concat!(env!("ISLE_DIR"), "/isle_numerics.rs"));
 
 #[macro_use]
-mod machinst;
+pub mod machinst;
 
 pub mod binemit;
 pub mod cfg_printer;
