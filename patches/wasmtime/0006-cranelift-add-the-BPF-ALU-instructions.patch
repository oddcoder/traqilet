From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ahmed Abdelraoof <ahmedsoliman@oddcoder.com>
Date: Sat, 5 Sep 2026 13:18:50 +0000
Subject: [PATCH] cranelift: add the BPF ALU instructions

BPF arithmetic is destructive. An opcode names two registers, dst_reg
and src_reg, and computes:
	dst_reg = dst_reg <op> src_reg

Lowering processes clif instructions. Each instruction with two inputs
and a separate result, and computes:
	d = s1 <op> s2

Reconciling that while lowering requires an additional mov:
	d = s1
	d = d <op> s2
That forces lowering to decide whether a mov is needed at all, and where
it goes. Naturally both are a concern of the register allocator, which is
the only thing that knows whether s1 is still live afterwards.

So, carry three registers in binary operators, and two registers in unary
operators, regardless of how RFC 9669 defines them. Later in the series,
use get_operands to tie the destination to the first operand, so the whole
problem becomes a register allocator problem.

Signed-off-by: Ahmed Abdelraoof <ahmedsoliman@oddcoder.com>
---
 cranelift/codegen/src/isa/bpf/inst.isle | 72 ++++++++++++++++++++++++-
 1 file changed, 71 insertions(+), 1 deletion(-)

diff --git a/cranelift/codegen/src/isa/bpf/inst.isle b/cranelift/codegen/src/isa/bpf/inst.isle
index b305c30..447f928 100644
--- a/cranelift/codegen/src/isa/bpf/inst.isle
+++ b/cranelift/codegen/src/isa/bpf/inst.isle
@@ -1,10 +1,80 @@
 ;; BPF machine instructions.
 
+;; RFC 9669 table 5. Neg, Mov, Movsx and End are handled separately.
+(type AluOp (enum Add Sub Mul Div SDiv Or And Lsh Rsh Mod SMod Xor Arsh))
+
+;; RFC 9669 table 3. Same instructions different word size.
+(type AluClass (enum Alu32 Alu64))
+
+;; RFC 9669 table 4.
+(type AluSource
+    (enum
+        (K (imm i32))
+        (X (rs2 Reg))
+    ))
+
+;; RFC 9669 table 5. A field for MOVSX.
+(type MovSXSize (enum S8 S16 S32))
+
+;; RFC 9669 section 4.2.
+(type EndWidth (enum W16 W32 W64))
+
+;; RFC 9669 table 6. ALU64 case is handled separately by End64.
+(type EndByteOrder (enum LE BE))
+
 (type MInst
     (enum
-        (Placeholder)
+        ;; RFC 9669 table 5.
+        (Alu (alu_op AluOp) (class AluClass) (rd WritableReg) (rs1 Reg) (src AluSource))
+
+        ;; RFC 9669 table 5
+        (Neg (class AluClass) (rd WritableReg) (rs Reg))
+
+        ;; RFC 9669 table 5
+        (Mov (class AluClass) (rd WritableReg) (src AluSource))
+
+        ;; RFC 9669 table 5
+        (MovSX (class AluClass) (size MovSXSize) (rd WritableReg) (rs Reg))
+
+        ;; RFC 9669 table 5 & section 4.2
+        (End (order EndByteOrder) (width EndWidth) (rd WritableReg) (rs Reg))
+
+        ;; RFC 9669 table 5 & section 4.2
+        (End64 (width EndWidth) (rd WritableReg) (rs Reg))
     ))
 
+;;;; Instruction constructors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+
+(decl alu (AluOp AluClass Reg AluSource) Reg)
+(rule (alu op class rs1 src)
+    (let ((rd WritableReg (temp_writable_reg $I64))
+          (_ Unit (emit (MInst.Alu op class rd rs1 src))))
+        rd))
+
+(decl alu_x (AluOp AluClass Reg Reg) Reg)
+(rule (alu_x op class rs1 rs2) (alu op class rs1 (AluSource.X rs2)))
+
+(decl alu_k (AluOp AluClass Reg i32) Reg)
+(rule (alu_k op class rs1 imm) (alu op class rs1 (AluSource.K imm)))
+
+(decl mov (AluClass AluSource) Reg)
+(rule (mov class src)
+    (let ((rd WritableReg (temp_writable_reg $I64))
+          (_ Unit (emit (MInst.Mov class rd src))))
+        rd))
+
+(decl mov_x (AluClass Reg) Reg)
+(rule (mov_x class rs) (mov class (AluSource.X rs)))
+
+(decl mov_k (AluClass i32) Reg)
+(rule (mov_k class imm) (mov class (AluSource.K imm)))
+
+(decl alu_neg (AluClass Reg) Reg)
+(rule (alu_neg class rs)
+    (let ((rd WritableReg (temp_writable_reg $I64))
+          (_ Unit (emit (MInst.Neg class rd rs))))
+        rd))
+
 (decl pure has_base64 () bool)
 (extern constructor has_base64 has_base64)
 
